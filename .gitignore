# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
.uv/

# macOS
.DS_Store

# Editors
.idea/
.vscode/

# Eval outputs — large, regenerable, not source of truth.
eval_runs/

# Pipeline job outputs (Phase 1) — large, regenerable.
runs/

# Local test inputs — user-local scratch dir.
samples/

# Local secrets
.env
.env.local

# Audio / large files that shouldn't be in git unless explicitly committed
*.wav
*.mp3
*.mp4
*.mkv
*.webm
# Allow committed sample audio under eval_data/ if needed:
!eval_data/**/*.wav

# Agent tool state — local to one machine, not shared.
# `.claude/commands/` IS tracked and shared (the agent-os slash commands), so
# .claude is ignored by contents rather than wholesale: ignoring the directory
# would silently swallow a command file added later.
.claude/*
!.claude/commands/
.impeccable/
