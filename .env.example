# Patmir secrets + machine settings. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env` and `.env.local` are gitignored; this template is not, so never put a
# real key here. `patmir/env.py` loads `.env` first, then `.env.local` on top of
# it (handy for a per-machine override). Shell-exported variables always win over
# both, so an `export` in ~/.bashrc silently beats anything written here.
#
# GOTCHA: the loader resolves `.env` against the CURRENT WORKING DIRECTORY, not
# the repo root. Run `patmir` from the repo, or export the vars in your shell.


# ─── Required for the active pipeline ─────────────────────────────────────────

# Translate is the only cloud stage. Without this key the pipeline fails at the
# translate stage; every other active stage is local.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ─── Machine settings ─────────────────────────────────────────────────────────

# Which candidate set runs, from `[pipeline.profiles.<name>]` in patmir.toml.
# Leave UNSET on Apple Silicon — the bare `[pipeline]` table is the MLX set.
# Set to `cuda` on the WSL2 + RTX 3090 workstation. A name with no matching
# profile is a hard error rather than a silent fall back to the MLX candidates.
# PATMIR_PROFILE=cuda

# Speaker-embedding backend for cross-section voice identity in watch-along.
# `ecapa` (default) or `redimnet`. Never switch mid-project without rebuilding
# the registry: embeddings from the two backends are not comparable, and each
# has its own calibrated match threshold.
# PATMIR_EMBED_BACKEND=ecapa

# HuggingFace cache location (~20 GB of models). On WSL2 keep this inside the
# Linux filesystem — a path under /mnt/c/ makes every load crawl.
# HF_HOME=/home/<you>/.cache/huggingface

# Pin these for a reproducible offline run once the models are cached, e.g. when
# benchmarking, so a silent re-download can't land inside a measurement.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1


# ─── Optional, per candidate ──────────────────────────────────────────────────

# Needed only when `[pipeline].diarize` (or a profile) selects `pyannote_3_1`.
# The active diarizers (`sortformer_mlx` on Mac, `sortformer_nemo` on CUDA) are
# ungated and need no token. pyannote additionally requires accepting the
# licence on all three gated repos it pulls in:
#   huggingface.co/pyannote/segmentation-3.0
#   huggingface.co/pyannote/speaker-diarization-3.1
#   huggingface.co/pyannote/speaker-diarization-community-1
# Falls back to the `hf auth login` cached token if this is unset.
# HF_TOKEN=

# ElevenLabs — Scribe v2 ASR/diarize and the eleven_v3 watch-along voice pool.
# Registered but inactive: the account ran out of credits (2026-06-15), which is
# what moved ASR + diarize local.
# ELEVENLABS_API_KEY=

# Registered-but-disabled cloud candidates. Only needed if you enable one in
# patmir.toml.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
